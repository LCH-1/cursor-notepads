  },
  "extensionKind": [
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LCH-1/cursor-notepads"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p . && cpx node_modules/sql.js/dist/sql-wasm.wasm out",
    "watch": "tsc -w",
    "pretest": "npm run compile",
    "test": "vscode-test",
    "lint": "eslint src",
    "package": "npx vsce package",
    "publish": "npm run compile && npx vsce publish",
    "publish:patch": "npm run compile && npx vsce publish patch",
    "publish:minor": "npm run compile && npx vsce publish minor",
    "publish:major": "npm run compile && npx vsce publish major",
    "ovsx:publish": "npx ovsx publish --pat $OVSX_TOKEN"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.76.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "cpx": "^1.5.0",
    "eslint": "^9.37.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "sql.js": "^1.13.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:cnp-notepad"
  ]
}
