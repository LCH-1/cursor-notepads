{
  "name": "cursor-notepads",
  "displayName": "Notepads",
  "description": "Notepads in the Explorer sidebar — create, edit, and manage notes.",
  "publisher": "lch",
  "version": "1.2.1",
  "icon": "notepad.png",
  "engines": {
    "vscode": "^1.76.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "notepad",
    "notepads",
    "note",
    "notes"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "markdown",
        "extensions": [
          ".np"
        ]
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "cnp.view",
          "name": "Notepads",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "commands": [
      {
        "command": "cnp.newNote",
        "title": "New Note",
        "category": "Notepads",
        "icon": "$(add)"
      },
      {
        "command": "cnp.refresh",
        "title": "Refresh",
        "category": "Notepads",
        "icon": "$(refresh)"
      },
      {
        "command": "cnp.deleteNote",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "cnp.renameNote",
        "title": "Rename",
        "icon": "$(edit)"
      },
      {
        "command": "cnp.restoreOriginalIconTheme",
        "title": "Restore Original File Icons",
        "category": "Notepads"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cnp.newNote",
          "when": "view == cnp.view",
          "group": "navigation@1"
        },
        {
          "command": "cnp.refresh",
          "when": "view == cnp.view",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "cnp.renameNote",
          "when": "view == cnp.view && viewItem == notepadItem",
          "group": "inline@1"
        },
        {
          "command": "cnp.deleteNote",
          "when": "view == cnp.view && viewItem == notepadItem",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "Notepads",
      "properties": {
        "cursorNotepads.verbose": {
          "type": "boolean",
          "default": false,
          "description": "Show verbose notifications for all actions (create, save, delete, rename)"
        },
        "cursorNotepads.noteTabIcon": {
          "type": "boolean",
          "default": true,
          "description": "Show a notebook icon on Notepads editor tabs while preserving other file icons."
        }
      }
    },
    "iconThemes": [
      {
        "id": "cnp-notepad-icons-0",
        "label": "Notepads Icons 1",
        "path": "./themes/notepads-0.json",
        "_watch": true
      },
      {
        "id": "cnp-notepad-icons-1",
        "label": "Notepads Icons 2",
        "path": "./themes/notepads-1.json",
        "_watch": true
      },
      {
        "id": "cnp-notepad-icons-2",
        "label": "Notepads Icons 3",
        "path": "./themes/notepads-2.json",
        "_watch": true
      },
      {
        "id": "cnp-notepad-icons-3",
        "label": "Notepads Icons 4",
        "path": "./themes/notepads-3.json",
        "_watch": true
      },
      {
        "id": "cnp-notepad-icons-4",
        "label": "Notepads Icons 5",
        "path": "./themes/notepads-4.json",
        "_watch": true
      },
      {
        "id": "cnp-notepad-icons-5",
        "label": "Notepads Icons 6",
        "path": "./themes/notepads-5.json",
        "_watch": true
      },
      {
        "id": "cnp-notepad-icons-6",
